# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo

# Video: raw footage stays out of Git. Only web-encoded films (see README,
# "Preparing a film", ~10 MB or less) named *-720.mp4 are committed.
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
!public/media/video/*-720.mp4

# Env & editor
.env
.env.*
!.env.example
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.log

# Local browser-testing output
.playwright-mcp/
